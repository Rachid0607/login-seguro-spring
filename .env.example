# Copie este arquivo para ".env" na raiz do projeto e preencha os valores reais.
# O arquivo ".env" NUNCA deve ser versionado (ja esta no .gitignore).

# String de conexao do cluster do MongoDB Atlas.
# Formato mongodb+srv:// (ja usa TLS/SSL por padrao).
# Obtida em: Atlas > Database > Connect > Drivers > Java.
# Crie um usuario de banco so com permissao readWrite no banco da aplicacao
# (nao use o usuario administrador do cluster aqui).
# MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Nome do banco de dados usado pela aplicacao (opcional).
# MONGODB_DATABASE=login_seguro

# Administrador inicial: criado automaticamente na primeira subida da aplicacao,
# somente se ainda nao existir nenhum usuario com perfil ADMINISTRADOR.
# Depois que o primeiro administrador existir, essas variaveis nao tem mais efeito
# (pode remove-las do .env com seguranca).
# ADMIN_NOME=Administrador
# ADMIN_EMAIL=admin@exemplo.com
# ADMIN_SENHA=defina-uma-senha-forte-aqui
